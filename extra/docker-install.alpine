#!/bin/sh

fn_usage() {
	echo "Usage : $(basename "${0}") [package]"
	exit 1
}

fn_refresh() {
	apk update $@
}

fn_update() {
	apk upgrade $@

	if [ -e /etc/TZ.apk-new ]; then
		mv /etc/TZ.apk-new /etc/TZ
	fi
}

fn_install() {
	local machine=$(uname -m)
	local execve_error=N
	local busybox_trigger=

	mkdir -p /triggers
	if [ "${machine/arm/}" != "${machine}" -o "${machine}" = "aarch64" ]; then
		if [ ! -z "\$(grep -w -o lm /proc/cpuinfo)" ]; then
			if ! /usr/local/bin/docker-execve-check &> /dev/null ; then
				execve_error=Y
			fi
		fi
	fi
	
	if [ "${execve_error}" = "Y" ]; then
		busybox_trigger=$(tar tf /lib/apk/db/scripts.tar | busybox grep 'busybox-.*\.trigger' | sed 's/busybox-[^-]*-[^\.]*\.\(.*\)\.trigger/\1/g')
		sed -i "s@${busybox_trigger}@#${busybox_trigger}@g" /lib/apk/db/triggers
	fi

	apk add $@ | tee /triggers/install.log

	if [ "${execve_error}" = "Y" ]; then
		local busybox_trigger2=$(tar tf /lib/apk/db/scripts.tar | busybox grep 'busybox-.*\.trigger' | sed 's/busybox-[^-]*-[^\.]*\.\(.*\)\.trigger/\1/g')
		if [ "${busybox_trigger}" != "${busybox_trigger2}" ]; then
			sed -i "@#${busybox_trigger}@d" /lib/apk/db/triggers
		else
			sed -i "s@#${busybox_trigger}@${busybox_trigger}@g" /lib/apk/db/triggers
		fi

		mkdir -p /triggers/scripts
		tar xf /lib/apk/db/scripts.tar -C /triggers/scripts
		for exe in $(cat /triggers/install.log | grep Executing | cut -f 2 -d ' ')
		do
			local name=$(echo ${exe} | sed 's/\(.*\)\.\([^\.]*\)/\1/g')
			local ext=$(echo ${exe} | sed 's/\(.*\)\.\([^\.]*\)/\2/g')

			for script in $(find /triggers/scripts | grep "${name}.*${ext}")
			do
				echo "Executing ${name}.${ext}"
				sh ${script}
			done
		done

		for script in $(find /triggers/scripts | grep "busybox-.*\.trigger")
		do
			echo "Executing busybox.trigger"
			sh ${script}
		done
		rm -rf /trigger/scripts
	fi

	rm -rf /triggers
}

fn_del() {
	local machine=$(uname -m)
	local execve_error=N
	local busybox_trigger=

	mkdir -p /triggers
	if [ "${machine/arm/}" != "${machine}" -o "${machine}" = "aarch64" ]; then
		if [ ! -z "\$(grep -w -o lm /proc/cpuinfo)" ]; then
			if ! /usr/local/bin/docker-execve-check &> /dev/null ; then
				execve_error=Y
			fi
		fi
	fi
	
	if [ "${execve_error}" = "Y" ]; then
		busybox_trigger=$(tar tf /lib/apk/db/scripts.tar | busybox grep 'busybox-.*\.trigger' | sed 's/busybox-[^-]*-[^\.]*\.\(.*\)\.trigger/\1/g')
		sed -i "s@${busybox_trigger}@#${busybox_trigger}@g" /lib/apk/db/triggers

		mkdir -p /triggers/scripts_prev
		tar xf /lib/apk/db/scripts.tar -C /triggers/scripts_prev
	fi

	apk del $@ --purge | tee /triggers/install.log

	if [ "${execve_error}" = "Y" ]; then
		local busybox_trigger2=$(tar tf /lib/apk/db/scripts.tar | busybox grep 'busybox-.*\.trigger' | sed 's/busybox-[^-]*-[^\.]*\.\(.*\)\.trigger/\1/g')
		if [ "${busybox_trigger}" != "${busybox_trigger2}" ]; then
			sed -i "@#${busybox_trigger}@d" /lib/apk/db/triggers
		else
			sed -i "s@#${busybox_trigger}@${busybox_trigger}@g" /lib/apk/db/triggers
		fi

		mkdir -p /triggers/scripts
		tar xf /lib/apk/db/scripts.tar -C /triggers/scripts
		for exe in $(cat /triggers/install.log | grep Executing | cut -f 2 -d ' ')
		do
			local name=$(echo ${exe} | sed 's/\(.*\)\.\([^\.]*\)/\1/g')
			local ext=$(echo ${exe} | sed 's/\(.*\)\.\([^\.]*\)/\2/g')

			if [ -z "$(find /triggers/scripts | grep "${name}.*${ext}")" ]; then
				for script in $(find /triggers/scripts_prev | grep "${name}.*${ext}")
				do
					echo "Executing ${name}.${ext}"
					sh ${script}
				done
			else
				for script in $(find /triggers/scripts | grep "${name}.*${ext}")
				do
					echo "Executing ${name}.${ext}"
					sh ${script}
				done
			fi
		done

		for script in $(find /triggers/scripts | grep "busybox-.*\.trigger")
		do
			echo "Executing busybox.trigger"
			sh ${script}
		done
		rm -rf /trigger/scripts /trigger/scripts_prev
	fi

	rm -rf /triggers
}

fn_clean() {
	rm -rf /var/cache/apk/* /tmp/install.log /tmp/scripts
}


#Main
if [ -z "${1}" ]; then
	fn_usage
fi

if [ "$(id -u)" != "0" ]; then
	echo "root privileges are required"
	exit 1
fi

PARAM_REFRESH=N
PARAM_UPDATE=N
PARAM_DEL=N
PARAM_CLEAN=N
PARAM_EXTRA=
PACKAGES=

while [ ${#} -gt 0 ]
do
	case "${1}" in
		-h|--help) fn_usage ;;
		-r|--refresh) PARAM_REFRESH=Y ;;
		-u|--update) PARAM_UPDATE=Y ;;
		-d|--del) PARAM_DEL=Y ;;
		-c|--cean) PARAM_CLEAN=Y ;;
		-o) PARAM_EXTRA="${PARAM_EXTRA} ${1} ${2}" ; shift ;;
		*) PACKAGES="${PACKAGES} ${1}" ;;
	esac
	shift
done

if [ "${PARAM_REFRESH}" = "Y" ]; then
	fn_refresh ${PARAM_EXTRA}
elif [ "${PARAM_UPDATE}" = "Y" ]; then
	fn_refresh ${PARAM_EXTRA}
elif [ ! -z "${PACKAGES}" -a -z "$(ls /var/cache/apk/* 2> /dev/null)" ]; then
	fn_refresh ${PARAM_EXTRA}
fi

if [ "${PARAM_UPDATE}" = "Y" ]; then
	fn_update ${PARAM_EXTRA}
fi

if [ ! -z "${PACKAGES}" ]; then
	if [ "${PARAM_DEL}" = "N" ]; then
		fn_install ${PARAM_EXTRA} ${PACKAGES}
	else
		fn_del ${PARAM_EXTRA} ${PACKAGES}
	fi
fi

if [ "${PARAM_CLEAN}" = "Y" ]; then
	fn_clean
fi

