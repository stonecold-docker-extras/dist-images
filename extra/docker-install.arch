#!/usr/bin/env bash

LC_ALL=C 

fn_usage() {
	echo "Usage : $(basename "${0}") [package]"
	exit 1
}

fn_refresh() {
	pacman -Sy --noconfirm --quiet
}

fn_update() {
	if [ "${USE_YAOURT}" = "Y" ]; then
		yaourt -Sua --noconfirm --m-arg "--skippgpcheck" ${@}

	else
		pacman -Su --noconfirm --quiet ${@}
	fi
}

fn_install() {
	#if [ -e /usr/local/bin/docker-sysusers ]; then
	#	mv /usr/bin/systemd-sysusers /usr/bin/systemd-sysusers.ORG
	#	ln -s /usr/local/bin/docker-sysusers /usr/bin/systemd-sysusers
	#fi

	if [ "${USE_YAOURT}" = "Y" ]; then
		yaourt -S --noconfirm --m-arg "--skippgpcheck" ${@}
	else
		pacman -S --noconfirm --quiet ${@}
	fi

	#if [ -e /usr/bin/systemd-sysusers.ORG ]; then
	#	rm -rf /usr/bin/systemd-sysusers
	#	mv /usr/bin/systemd-sysusers.ORG /usr/bin/systemd-sysusers
	#fi
}

fn_del() {
	pacman -Rsn --noconfirm ${@}
}

fn_yaourt_start() {
	sed -i 's/if (( EUID == 0 ))/if (( EUID == -1 ))/g' /usr/bin/makepkg || prev_makepkg_mod=N

	if [ "$(uname -m)" = "x86_64" ]; then
		pacman -S --noconfirm --quiet --needed --asdeps base-devel multilib-devel git
	else
		pacman -S --noconfirm --quiet --needed --asdeps base-devel git
	fi

	local aur=
	for aur in package-query yaourt
	do
		if [ ! -z "$(pacman -Qq ${aur} 2> /dev/null)" ]; then
			continue
		fi
		rm -rf /build
		mkdir -p /build
		local prev_dir=$(pwd)
		mkdir -p /build/${aur}
		cd /build/${aur}
		git clone --depth 1 -c http.sslverify=false https://aur.archlinux.org/${aur}.git .
		makepkg -cCrsi --asdeps --noconfirm --needed
		cd ${prev_dir}
		rm -rf /build
	done
}

fn_yaourt_end() {
	[ "${prev_makepkg_mod}" = "Y" ] && sed -i 's/if (( EUID == -1 ))/if (( EUID == 0 ))/g' /usr/bin/makepkg
}

fn_clean() {
	if [ ! -z "$(pacman -Qdtq 2> /dev/null)" ]; then
		pacman -Rsn --noconfirm $(pacman -Qdtq)
	fi
	while :
	do
		local remove_pkg=
		for pkg in $(pacman -Qdq)
		do
			if [ ! -z "$(pacman -Qi ${pkg} | grep 'Required By\s\+: None')" ]; then
				remove_pkg+="${pkg} "
			fi
		done
		if [ ! -z "${remove_pkg}" ]; then
			pacman -Rsn --noconfirm ${remove_pkg}
		else
			break
		fi
	done
	if [ -z "$(pacman -Qq git 2> /dev/null)" -a ! -z "$(getent passwd git 2> /dev/null)" ]; then
		userdel git
	fi
	rm -rf /etc/pacman.d/mirrorlist.pacnew
	echo -e "Y\nY" | pacman -Scc &> /dev/null
	rm -rf /qemu_sh_*.core /var/log/pacman.log /var/cache/pacman/pkg/* /var/lib/pacman/sync/* /tmp/yaourt-tmp-*
}


#Main
if [ -z "${1}" ]; then
	fn_usage
fi

if [ "$(id -u)" != "0" ]; then
	echo "root privileges are required"
	exit 1
fi

USE_YAOURT=N
PARAM_REFRESH=N
PARAM_UPDATE=N
PARAM_DEL=N
PARAM_CLEAN=N
PARAM_EXTRA=()
PACKAGES=()

while [[ ${#} > 0 ]]
do
	case "${1}" in
		-h|--help) fn_usage ;;
		-y|--yaourt) USE_YAOURT=Y ;;
		-r|--refresh) PARAM_REFRESH=Y ;;
		-u|--update) PARAM_UPDATE=Y ;;
		-d|--del) PARAM_DEL=Y ;;
		-c|--cean) PARAM_CLEAN=Y ;;
		--asdeps) PARAM_EXTRA+=(--asdeps) ;;
		--asexplicit) PARAM_EXTRA+=(--asexplicit) ;;
		--assume-installed) PARAM_EXTRA+=(${1} ${2}) ; shift ;;
		*) PACKAGES+=(${1}) ;;
	esac
	shift
done

if [ "${PARAM_REFRESH}" = "Y" ]; then
	fn_refresh
elif [ "${PARAM_UPDATE}" = "Y" ]; then
	fn_refresh
elif [ "${USE_YAOURT}" = "Y" -a ! -e /var/lib/pacman/sync/core.db ]; then
	fn_refresh
elif [ ! -z "${PACKAGES}" -a ! -e /var/lib/pacman/sync/core.db ]; then
	fn_refresh
fi

if [ "${USE_YAOURT}" = "Y" ]; then
	fn_yaourt_start
fi

if [ "${PARAM_UPDATE}" = "Y" ]; then
	fn_update ${PARAM_EXTRA[@]}
fi

if [ ! -z "${PACKAGES}" ]; then
	if [ "${PARAM_DEL}" = "N" ]; then
		fn_install ${PARAM_EXTRA[@]} ${PACKAGES[@]}
	else
		fn_del ${PARAM_EXTRA[@]} ${PACKAGES[@]}
	fi
fi

if [ "${USE_YAOURT}" = "Y" ]; then
	fn_yaourt_end
fi

if [ "${PARAM_CLEAN}" = "Y" ]; then
	fn_clean
fi

