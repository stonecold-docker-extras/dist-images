#!/bin/sh

set -e

if [ -z "$(which node 2> /dev/null)" -o -z "$(which api 2> /dev/null)" -o ! -e /opt/node_modules/docker-hub-api/play.js ]; then
	echo "Cannot found docker-hub-api"
	exit 1
fi

for md in *.md
do
	name=${md/README_/}
	name=${name/.md/}
	echo ${name}
	api setRepositoryDescriptionFullFromFile forumi0721 ${name} ${md}
	echo
done

