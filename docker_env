#!/usr/bin/env bash

CONTAINER=
if command -v podman >/dev/null 2>&1; then
    CONTAINER="podman"
elif command -v docker >/dev/null 2>&1; then
    CONTAINER="docker"
else
    echo "docker 또는 podman이 필요합니다." >&2
    exit 1
fi

if [ "${CONTAINER}" = "docker" -a -e /.dockerenv ]; then
	echo "Cannot run in docker"
	exit 1
#elif [ "${CONTAINER}" = "podman " -a -e /.init ]; then
elif [ "${CONTAINER}" = "podman " -a "${container}" = "podman" ]; then
	echo "Cannot run in podman"
	exit 1
fi

if [ "${CONTAINER}" = "podman" ]; then
	CONTAINER="sudo ${CONTAINER}"
fi

SESSION=
if command -v tmux >/dev/null 2>&1; then
    SESSION="tmux new-session -s 'docker-dist-images'"
elif command -v screen >/dev/null 2>&1; then
    SESSION="screen -S 'docker dist-images' -m"
fi

${SESSION} \
${CONTAINER} run -i -t --rm --sig-proxy=false \
	--privileged \
	-e RUN_USER_NAME=$(id -un) \
	-e RUN_USER_UID=$(id -u) \
	-e RUN_USER_GID=$(id -g) \
	-e LANG=ko_KR.UTF-8 \
	-e LC_ALL=ko_KR.UTF-8 \
	-e USER_NAME=root \
	-e SRC_DIR=/docker \
	-e MOUNT_DIR=/docker/dist \
	$([ -e `pwd`/docker/home ] && echo "-v `pwd`/docker/home:/home") \
	$([ -e `pwd`/docker/root ] && echo "-v `pwd`/docker/root:/root") \
	$([ -e `pwd`/docker/docker-run-pre ] && echo "-v `pwd`/docker/docker-run-pre:/usr/local/bin/docker-run-pre") \
	-v `pwd`:/docker \
	-w /docker \
	-v `pwd`/extras/qemu-arm-static:/usr/bin/qemu-arm-static \
	-v `pwd`/extras/qemu-aarch64-static:/usr/bin/qemu-aarch64-static \
	-h alpine-x64-dev-docker \
	--name alpine-x64-dev-docker-${RANDOM} \
	forumi0721/alpine-dev:latest
